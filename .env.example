# Copy to .env for local development. Bun loads .env automatically.
# Every variable is read and validated in apps/web/lib/env.ts.

# Local port for `bun run dev` and `bun run start` (default 3000).
# PORT=3000

# `0` turns off hot module reload in `bun run dev` (Bun's HMR rejects tunnel hosts).
# DEV_HMR=0

# Public origin, required for production builds, e.g. https://botrepel.com.
# SITE_URL=

# `1` keeps every page out of search engines even in production.
# SEO_NOINDEX=1

# Database. Local development uses SQLite at apps/web/.data/botrepel.sqlite; production needs Postgres.
# DATABASE_URL=postgres://user:pass@host/db
# DATABASE_PATH=apps/web/.data/botrepel.sqlite

# Auth. BETTER_AUTH_URL defaults to SITE_URL, or http://localhost:$PORT locally.
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=   # required in production: `openssl rand -base64 32`

# Sign-in providers. Callback URLs: <origin>/api/auth/callback/github and /callback/google.
# On Vercel, set them for Production only: previews run on per-deployment URLs and keep the magic link.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (magic links, low-credit notices). Without these, local development logs each email.
# RESEND_API_KEY=
# EMAIL_FROM="BotRepel <hello@botrepel.com>"

# Required in production; local development uses fixed values.
# CHALLENGE_SECRET=     # signs proof-of-work puzzles, hashes IP addresses
# PASS_PSEUDONYM_KEY=   # derives per-site Human Pass pseudonyms

# Credit top-ups through Stripe Checkout. Webhook endpoint: <origin>/v1/stripe/webhook,
# event checkout.session.completed. Locally: `stripe listen --forward-to localhost:3000/v1/stripe/webhook`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# The home page's live demo: a site owned by a house account, allowing localhost and the production
# domain. `bun run demo:seed` creates one locally and prints both lines. Without them the demo is hidden.
# PUBLIC_DEMO_SITE_KEY=br_pk_...
# DEMO_SECRET_KEY=br_sk_...

# Verified addresses that may open /admin/liveness, comma-separated.
# ADMIN_EMAILS=you@example.com

# Light-check attempts per check, retries included (a failed check also earns a retry until then). Default 3.
# LIVENESS_MAX_ATTEMPTS=3
