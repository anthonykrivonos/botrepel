{
  "name": "botrepel",
  "version": "0.1.0",
  "description": "Human verification for your sign-ups, logins, and forms, with a React widget, server verification, auth integrations, and CLI in one package. Get started with npx botrepel init.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth/index.d.ts",
      "default": "./dist/better-auth/index.js"
    },
    "./next-auth": {
      "types": "./dist/next-auth.d.ts",
      "default": "./dist/next-auth.js"
    },
    "./auth0": {
      "import": {
        "types": "./dist/auth0.d.ts",
        "default": "./dist/auth0.js"
      },
      "require": {
        "types": "./dist/auth0.d.cts",
        "default": "./dist/auth0.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "botrepel": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts"
  },
  "devDependencies": {
    "@botrepel/protocol": "workspace:*"
  },
  "peerDependencies": {
    "better-auth": "^1.4.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
